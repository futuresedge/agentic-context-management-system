# DLMS TypeDB Schema — Phase 1.1
# Target: TypeDB 3.x
# ONE Ontology dimensions:
#   Things      → document, stage_artefact
#   People      → agent_class, agent_instance
#   Groups      → group (dlms-internal default; multi-tenancy dormant)
#   Connections → dependency relation, supersession relation
#   Events      → audit_event (append-only enforced at application layer), stage_transition subtype
#   Knowledge   → knowledge_entry
#
# Enum-like fields (doc_type, status, rel_type, etc.) are typed as `string` here.
# Validation against the controlled vocabulary is enforced in TS/zod at the tool handler layer.
#
# Append-only constraint on audit_event is enforced by client.ts — no TypeQL delete
# is permitted in any tool handler. The TypeDB schema itself cannot enforce this natively.

define

  # ---------------------------------------------------------------------------
  # ATTRIBUTE TYPES
  # Must be defined before the entities/relations that own them.
  # ---------------------------------------------------------------------------

  # --- Things dimension ---

  doc_id value string;
  title value string;
  doc_type value string;
  # enum: policy | procedure | standard | pattern | sla | specification | reference | report | taxonomy | template

  status value string;
  # enum: draft | under_review | approved | superseded | archived

  version value string;
  # semver: MAJOR.MINOR.PATCH

  created_at value datetime;
  created_by value string;
  # format: agent:[role-slug] | bootstrap:[team-slug] | seed:import-corpus

  approved_at value datetime;
  approved_by value string;
  verified_by value string;
  template_id value string;
  # format: TMPL-[type]-NNN | self | bootstrap

  template_ver value string;
  # semver or empty string when not applicable

  tag value string;
  # Multiple instances per document entity. Controlled vocabulary (DLMS-2026-0021).

  supersedes_doc value string;
  # doc_id of the document this supersedes. Empty string when not applicable.

  superseded_by_doc value string;
  # doc_id of the document that supersedes this. Empty string when not applicable.

  retention_class value string;
  # enum: RC-permanent | RC-1 | RC-2 | RC-3 | RC-4 | RC-5 | RC-6 | RC-7

  context_eligible value boolean;
  agent_path value string;
  # Immutable per version. Filesystem path: /dlms/corpus/[type-plural]/[doc_id]-v[version].md

  audit_ref value string;
  # format: AUDIT-[doc_id] | AUDIT-BOOTSTRAP-[NNNN]

  sections value string;
  # Serialised JSON map: { "SUMMARY": "...", "RULES": "...", ... }
  # Canonical section order for render-back: SUMMARY, SCOPE, DEFINITIONS, RULES,
  # ENFORCEMENT, DEPENDENCIES, CHANGE_LOG

  # stage_artefact fields
  artefact_id value string;
  # UUID generated at write time. Used as @key on stage_artefact.

  artefact_type value string;
  # e.g. creation-context | draft-v0.1-agent | review-accuracy | metadata-final | ...

  stage value string;
  # e.g. creation | review | indexing | storage | distribution | archival

  content value string;
  # freetext or serialised JSON payload for stage artefacts

  # --- People dimension ---

  role_id value string;
  # Unique per agent class. e.g. document-author | review-verifier

  tier value long;
  # Integer 1–14 matching the agent roster tier number

  tool_list_json value string;
  # JSON array of MCP tool names this agent class is permitted to call.
  # Runtime cross-referenced against the Tool Access Registry.

  instance_id value string;
  # Unique per agent instance (UUID).

  class_id value string;
  # References role_id of the parent agent_class.

  activated_at value datetime;

  # --- Groups dimension ---

  group_id value string;
  group_type value string;
  # Default: dlms-internal. Multi-tenancy dormant — group entity exists in schema
  # but all current documents belong to dlms-internal. Do not activate without a
  # deliberate multi-tenancy design decision.

  # --- Connections dimension ---

  rel_type value string;
  # enum: is-governed-by | implements | references | supersedes (DLMS-2026-0020)

  superseded_at value datetime;

  # --- Events dimension ---

  event_id value string;
  # UUID. Used as @key on audit_event.

  event_type value string;
  # Must match a slug in dlms/registry/event-type-registry.md.
  # Validated at write time by appendAuditEvent() in audit.ts.

  actor_id value string;
  # format: agent:[role-slug] | nexus:gateway | seed:import-corpus

  target_id value string;
  # doc_id or artefact_id of the affected entity

  target_version value string;
  # semver of target at time of event. Empty string when not applicable.

  payload_json value string;
  # Serialised JSON. Structure varies by event_type. See event-type-registry.md.

  from_stage value string;
  # stage_transition only. The stage the document is leaving.

  to_stage value string;
  # stage_transition only. The stage the document is entering.

  timestamp value datetime;

  # --- Knowledge dimension ---

  subject_doc_type value string;
  # doc_type the learning applies to

  subject_stage value string;
  # pipeline stage the learning applies to

  insight value string;
  # Freetext learning captured by a stage verifier

  confidence value double;
  # 0.0–1.0. Set by the verifier agent at time of writing.

  embedding_json value string;
  # TODO: Replace with TypeDB native vector attribute when TypeDB 3.x vector
  # similarity support is confirmed stable. Currently a JSON array of doubles.
  # Populated lazily by knowledge.writeEntry handler.

  # ---------------------------------------------------------------------------
  # ENTITY TYPES
  # ---------------------------------------------------------------------------

  # --- Things: document ---
  # Represents a DLMS corpus document. All 20 frontmatter fields from DLMS-2026-0004
  # plus sections (body) and tag (multiple instances).

  document owns doc_id @key,
            owns title,
            owns doc_type,
            owns status,
            owns version,
            owns created_at,
            owns created_by,
            owns approved_at,
            owns approved_by,
            owns verified_by,
            owns template_id,
            owns template_ver,
            owns tag,
            # tag is declared once but multiple instances per entity are permitted in TypeDB.
            owns supersedes_doc,
            owns superseded_by_doc,
            owns retention_class,
            owns context_eligible,
            owns agent_path,
            owns audit_ref,
            owns sections;

  # --- Things: stage_artefact ---
  # An artefact produced at a specific pipeline stage for a specific document.
  # artefact_id is a UUID generated at write time (see commitment in plan.md).

  stage_artefact owns artefact_id @key,
                 owns doc_id,
                 owns artefact_type,
                 owns stage,
                 owns content,
                 owns created_by,
                 owns created_at;

  # --- People: agent_class ---
  # Represents an agent role (e.g. document-author, review-verifier).
  # One entity per role in the agent roster. Seeded from dlms-agent-roster.md.

  agent_class owns role_id @key,
              owns tier,
              owns tool_list_json;

  # --- People: agent_instance ---
  # Represents a specific activation of an agent class.

  agent_instance owns instance_id @key,
                 owns class_id,
                 owns activated_at;

  # --- Groups: group ---
  # Multi-tenancy container. Dormant — all current documents use dlms-internal.
  # Do not activate without a deliberate multi-tenancy design decision.

  group owns group_id @key,
        owns group_type;

  # --- Events: audit_event ---
  # Append-only event log. No TypeQL delete is permitted on this entity type.
  # Constraint is enforced by client.ts — tool handlers call writeTransaction()
  # which wraps audit appends and business writes in a single shared transaction.

  audit_event owns event_id @key,
              owns event_type,
              owns actor_id,
              owns target_id,
              owns target_version,
              owns timestamp,
              owns payload_json;

  # --- Events: stage_transition (subtype of audit_event) ---
  # Produced by routing.dispatchStage(). Adds from_stage + to_stage to the base
  # audit_event fields. TypeDB returns stage_transition instances when querying
  # `match $e isa audit_event;` — subtypes are included in supertype queries.

  stage_transition sub audit_event,
                   owns from_stage,
                   owns to_stage;

  # --- Knowledge: knowledge_entry ---
  # Accumulated learnings from stage verifiers. Queried by Context Compressor (Tier 11)
  # and knowledge.readEntry tool to inform context packaging decisions.
  # No @key — query by subject_doc_type + subject_stage combination.

  knowledge_entry owns subject_doc_type,
                  owns subject_stage,
                  owns insight,
                  owns confidence,
                  owns created_at,
                  owns embedding_json;

  # ---------------------------------------------------------------------------
  # RELATION TYPES
  # ---------------------------------------------------------------------------

  # --- Connections: dependency ---
  # Directed relation between two documents.
  # rel_type enum: is-governed-by | implements | references | supersedes
  # Source is the depending document; target is the depended-upon document.
  # Populated during corpus seed (Phase 1.3) and updated by
  # indexing.dispatchIndexUpdates → relationship.upsertDependency (Phase 6.3).

  dependency relates source,
             relates target,
             owns rel_type;

  document plays dependency:source,
           plays dependency:target;

  # --- Connections: supersession ---
  # Explicit supersession link between two document versions.
  # Complements the supersedes_doc / superseded_by_doc string attributes on document,
  # providing a traversable graph edge for dependency impact analysis.

  supersession relates old_doc,
               relates new_doc,
               owns superseded_at;

  document plays supersession:old_doc,
           plays supersession:new_doc;
